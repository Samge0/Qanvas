    <!-- v1.1.4 additions: background reliability -->
    <string name="set_bg_title">Background running</string>
    <string name="set_bg_desc">A 7-minute generation must survive app switching. Qanvas keeps a silent progress overlay on screen (keeps GPU scheduling) and a muted audio focus (prevents system freezing) while generating. Both stop automatically when the job ends.</string>
