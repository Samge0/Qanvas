    <!-- hot load -->
    <string name="set_keep_title">Performance</string>
    <string name="set_keep_enable">Keep model in memory (hot reload)</string>
    <string name="set_keep_desc">Skips the ~20–30 s model load on every generation. Costs ~4–6 GB of reserved RAM while enabled; free it anytime by turning this off.</string>
    <string name="set_keep_warn">⚠️ Enable with care: this reserves ~4–6 GB of RAM. On phones with less than 12 GB of RAM, or when other heavy apps are running, generations are much more likely to hit out-of-memory and fail. Recommended only on 12 GB+ devices that mostly generate in one sitting.</string>

